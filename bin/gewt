#!/usr/bin/env bun
import { execSync } from "child_process";
import { getWtDir } from "./wt-path";

const [branch] = process.argv.slice(2);

if (!branch) {
  console.error("Usage: gewt <branch>");
  process.exit(1);
}

const remote = execSync("git remote get-url origin").toString().trim();
const repoRoot = execSync("git rev-parse --show-toplevel").toString().trim();
const wtBase = process.env.WORKTREE_BASE ?? `${process.env.HOME}/.worktrees`;

const wtDir = getWtDir(repoRoot, remote, branch, wtBase);

execSync(`git worktree add "${wtDir}" "${branch}"`, { stdio: "inherit" });

console.log(wtDir);
