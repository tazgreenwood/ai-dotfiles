#!/usr/bin/env bun
import { execSync } from "child_process";
import { copyFileSync, mkdirSync } from "fs";
import { join, basename } from "path";
import { getWtDir } from "./wt-path";

const [branch, base = "main"] = process.argv.slice(2);

if (!branch) {
  console.error("Usage: gnwt <branch> [base=main]");
  process.exit(1);
}

const remote = execSync("git remote get-url origin").toString().trim();
const repoRoot = execSync("git rev-parse --show-toplevel").toString().trim();
const wtBase = process.env.WORKTREE_BASE ?? `${process.env.HOME}/.worktrees`;

const wtDir = getWtDir(repoRoot, remote, branch, wtBase);

execSync(`git worktree add -b ${branch} ${wtDir} ${base}`, { stdio: "inherit" });

// Copy untracked root files (not directories) to the new worktree
const untrackedOutput = execSync(
  `git -C ${repoRoot} ls-files --others --exclude-standard --directory`,
).toString();

for (const line of untrackedOutput.split("\n")) {
  const entry = line.trim();
  if (!entry || entry.endsWith("/")) continue;
  copyFileSync(join(repoRoot, entry), join(wtDir, basename(entry)));
}

console.log(wtDir);
